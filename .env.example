# Copie para .env e preencha. Credenciais: peça ao grupo/autor por mensagem privada.

# --- Neo4j: Aura (padrão, banco compartilhado do grupo) ---
# Atenção: no Aura o usuário é o ID da instância (o trecho antes de .databases.neo4j.io) OU Username
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USER=XXXXXXXX
NEO4J_PASSWORD=troque-esta-senha

# --- Neo4j: local (Docker), reserva. Para usar, descomente este bloco e comente o de cima ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=troque-esta-senha

# --- LLMs (OpenRouter) ---
OPENROUTER_KEY=sk-or-...
EXTRACTION_MODEL=deepseek/deepseek-v4.1-flash-1017
EXTRACTION_REASONING=0
CYPHER_MODEL=baidu/ernie-5.5-flash-preview:free
ANSWER_MODEL=baidu/ernie-5.5-flash-preview:free
EMBEDDING_MODEL=baai/bge-m3
